{
  "name": "kaitu-fortune",
  "version": "0.1.5",
  "description": "DSH 插件：MBTI、中式命理、西洋星盘与塔罗，本机测试、解读与新对话",
  "type": "module",
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "https://github.com/Stahl-G/dsh-kaitu-fortune.git"
  },
  "exports": {
    ".": "./dist/index.js",
    "./client": "./dist/client.js",
    "./typert": {
      "types": "./lib/typert.host.d.ts",
      "default": "./lib/typert.host.js"
    },
    "./remote": {
      "types": "./lib/typert.remote-client.d.ts",
      "default": "./lib/typert.remote-client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "data",
    "lib/typert.host.js",
    "lib/typert.host.d.ts",
    "lib/typert.remote-client.js",
    "lib/typert.remote-client.d.ts",
    "cordis.patch.yml",
    "LICENSE",
    "README.md",
    "THIRD_PARTY_NOTICES.md",
    "THIRD_PARTY_LICENSES.txt",
    "third_party",
    "licenses",
    "src",
    "scripts",
    "tsconfig.json",
    "tsconfig.client.json",
    "pnpm-lock.yaml"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  },
  "kaitu": {
    "explore": {
      "title": {
        "zh": "命理与星象",
        "en": "Fortune"
      },
      "description": "MBTI 自测与 AI 猜测，八字、紫微、星盘与塔罗",
      "icon": "命",
      "page": "kaitu-fortune"
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.client.json",
    "lint": "biome check ."
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.5"
  },
  "devDependencies": {
    "@astrodraw/astrochart": "3.0.2",
    "@biomejs/biome": "1.9.4",
    "@deepseek-ai/cordis": "4.0.5",
    "@deepseek-ai/dsh-api-remotes": "0.2.1-rc.3",
    "@deepseek-ai/dsh-client-ui-layout": "0.2.1-rc.3",
    "@deepseek-ai/dsh-client-ui-renderer": "0.2.1-rc.3",
    "@deepseek-ai/dsh-client-ui-sidebar": "0.2.1-rc.3",
    "@deepseek-ai/dsh-client-ui-slots": "0.2.1-rc.3",
    "@deepseek-ai/dsh-typert-generator": "0.2.1-rc.3",
    "@deepseek-ai/dsh-typert-registry": "0.2.1-rc.3",
    "@types/node": "^22.20.5",
    "@types/react": "18.3.31",
    "esbuild": "0.28.2",
    "lightningcss": "1.33.0",
    "lunar-javascript": "1.7.7",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "taibu-core": "3.6.0",
    "typescript": "5.9.3",
    "tz-lookup": "6.1.25",
    "vitest": "3.2.4",
    "zod": "4.4.3"
  },
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": "^22.19.0 || >=24",
    "dsh": "0.2.1-rc.3"
  },
  "dependencies": {
    "@deepseek-ai/dsh-typert-protocol": "0.2.1-rc.3"
  }
}
