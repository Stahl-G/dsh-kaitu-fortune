{
  "name": "kaitu-fortune",
  "version": "0.0.0",
  "description": "DSH 插件：八字、紫微、黄历、六爻、塔罗与西洋星盘，先盲读、再结合近况",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Stahl-G/dsh-kaitu-fortune.git"
  },
  "exports": {
    ".": "./dist/index.js",
    "./package.json": "./package.json"
  },
  "files": ["dist", "cordis.patch.yml", "LICENSE", "THIRD_PARTY_NOTICES.md", "README.md"],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "biome check ."
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.5"
  },
  "devDependencies": {
    "@biomejs/biome": "1.9.4",
    "@deepseek-ai/cordis": "4.0.5",
    "@types/node": "^22.20.5",
    "esbuild": "0.28.2",
    "typescript": "5.9.3",
    "vitest": "3.2.4",
    "taibu-core": "3.6.0"
  },
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": "^22.19.0 || >=24"
  }
}
